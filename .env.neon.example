# ==============================================================================
# .env.neon.example
# Neon PostgreSQL 16 Environment Configuration Template
# ==============================================================================
# Usage:
# 1. Copy this file to '.env.neon':
#    Copy-Item .env.neon.example .env.neon
# 2. Fill in your actual Neon credentials and endpoints below.
# 3. '.env.neon' is git-ignored and will never be committed.
# 4. To run commands against Neon without touching local '.env':
#    $env:ENV_FILE = ".env.neon"; .\.venv\Scripts\python.exe ...
# ==============================================================================

# PostgreSQL Server Configuration (Neon Direct Endpoint)
# Direct endpoint hostname from Neon Console (e.g. ep-cool-fog-123456.us-east-2.aws.neon.tech)
# Do NOT include the '-pooler' suffix for Alembic migrations and DDL setup.
# Do NOT include 'postgresql://' or 'https://' prefixes.
POSTGRES_HOST=ep-your-project-id.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb

# Superuser / Project Admin Role (Bootstrap owner on Neon)
POSTGRES_ADMIN_USER=neondb_owner
POSTGRES_ADMIN_PASSWORD=your_neon_admin_password_here

# Application Service Role (Owns app_metadata schema, runs Alembic migrations, writes query audit logs)
APP_DB_USER=app_user
APP_DB_PASSWORD=your_strong_app_user_password_here

# Analytics Execution Role (Restricted read-only role for Copilot query execution)
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=your_strong_analytics_user_password_here

# SSL Mode Configuration (MANDATORY for Neon)
# Direct Neon connections require SSL encryption.
PGSSLMODE=require

# Serverless Connection Management
# Enforces NullPool to prevent connection leaks across Neon compute scale-to-zero / suspend cycles.
DB_SERVERLESS_MODE=true

# Guardrail Defaults
ANALYTICS_STATEMENT_TIMEOUT_MS=3000
MAX_QUERY_ROW_LIMIT=1000
ENVIRONMENT=development

# LLM Provider Configuration (Phase 2 & 4)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=5.0

# Logging & Observability (Phase 4)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting & Security (Phase 4)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=65536
TRUST_PROXY_HEADERS=false

# Frontend Configuration (Phase 3)
API_BASE_URL=http://127.0.0.1:8000
