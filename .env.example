# PostgreSQL Server Configuration
# Local Docker default: localhost / 5432 / sql_analytics_db
# Neon Serverless: ep-....neon.tech (direct endpoint without -pooler) / 5432 / neondb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sql_analytics_db

# SSL Mode Configuration:
# - Leave commented out or 'disable' for local Docker PostgreSQL
# - Set to 'require' for Neon and remote cloud PostgreSQL instances
# - In production (ENVIRONMENT=production), securely defaults to 'require'
# PGSSLMODE=require

# Serverless Connection Pooling (Phase 5 / AWS Lambda & Neon):
# - Set to true to enforce NullPool (prevents connection leaks across autoscaling & scale-to-zero)
# - Leave false for standard long-lived processes using QueuePool
# DB_SERVERLESS_MODE=false

# Superuser / Admin (used only for initial container initialization & migrations if needed)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_password

# Application Service Role (owns metadata schema, logs queries, manages app migrations)
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_dev_password

# Analytics Execution Role (strictly read-only on business data, blocked from metadata, statement timeout enforced)
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=analytics_user_dev_password

# Guardrail Defaults
ANALYTICS_STATEMENT_TIMEOUT_MS=3000
MAX_QUERY_ROW_LIMIT=1000
ENVIRONMENT=development

# LLM Provider Configuration (Phase 2 & 4)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=5.0

# Logging & Observability (Phase 4)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting & Security (Phase 4)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=65536
TRUST_PROXY_HEADERS=false

# Frontend Configuration (Phase 3)
API_BASE_URL=http://127.0.0.1:8000

